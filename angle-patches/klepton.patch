+// Klepton: the variable-rasterization-rate registry. See mtl_common.h.
+namespace
+{
+
+struct RateMapRegistry
+{
+    std::mutex lock;
+    // Both sides retained. The MAP for the obvious reason; the TEXTURE because
+    // the map is keyed on its address and a released texture's address can be
+    // handed straight back out by the allocator — a stale entry would then
+    // silently foveate a completely unrelated render target, which is a wrong
+    // picture with nothing anywhere reporting it. Retaining costs a leak if the
+    // caller forgets to unbind, and a leak is the better failure.
+    std::unordered_map<void *, std::pair<angle::ObjCPtr<id<MTLTexture>>,
+                                         angle::ObjCPtr<id<MTLRasterizationRateMap>>>>
+        entries;
+    // Keyed on (width << 32) | height. No texture to retain here, so no lifetime
+    // question — a size is not an address and cannot be recycled into a
+    // different object.
+    std::unordered_map<uint64_t,
+                       std::pair<uint32_t, angle::ObjCPtr<id<MTLRasterizationRateMap>>>>
+        bySize;
+    // Read on every render pass build, written only when a binding changes, so
+    // the overwhelmingly common "nothing registered" case never takes the lock.
+    // Counts BOTH tables — a size rule alone must still switch the lookup on.
+    std::atomic<size_t> count{0};
+
+    void recount() { count.store(entries.size() + bySize.size(), std::memory_order_relaxed); }
+};
+
+static uint64_t SizeKey(uint32_t width, uint32_t height)
+{
+    return (static_cast<uint64_t>(width) << 32) | height;
+}
+
+RateMapRegistry &Registry()
+{
+    static RateMapRegistry *registry = new RateMapRegistry();
+    return *registry;
+}
+
+}  // anonymous namespace
+
+bool AnyRasterizationRateMapsRegistered()
+{
+    return Registry().count.load(std::memory_order_relaxed) != 0;
+}
+
+bool RasterizationRateTraceEnabled()
+{
+    static const bool enabled = getenv("KL_ANGLE_VRR_TRACE") != nullptr;
+    return enabled;
+}
+
+id<MTLRasterizationRateMap> GetRasterizationRateMapFor(id<MTLTexture> texture)
+{
+    if (!texture || !AnyRasterizationRateMapsRegistered())
+    {
+        return nil;
+    }
+    RateMapRegistry &registry = Registry();
+    std::lock_guard<std::mutex> guard(registry.lock);
+    // Walk the view chain, not just the texture handed in. A texture that
+    // reaches a render pass is very often NOT the object the caller registered:
+    // an EGLImage-backed GL texture (EGL_ANGLE_metal_texture_client_buffer, which
+    // is how the guest's eye textures arrive) becomes a texture VIEW of ours to
+    // carry the requested internalformat and array slice, and ANGLE makes
+    // further views of its own for sRGB-linear and stencil reads. Every one of
+    // them is a distinct id<MTLTexture> with the SAME storage, which is what the
+    // map actually belongs to. Keying on identity alone measured as "no map
+    // registered" with the registration plainly right — a full pass of the spike
+    // failed on exactly this.
+    for (id<MTLTexture> t = texture; t != nil; t = [t parentTexture])
+    {
+        auto it = registry.entries.find((void *)t);
+        if (it != registry.entries.end())
+        {
+            return it->second.second.get();
+        }
+    }
+    return nil;
+}
+
+id<MTLRasterizationRateMap> GetRasterizationRateMapForTarget(id<MTLTexture> texture,
+                                                             uint32_t width,
+                                                             uint32_t height,
+                                                             uint32_t samples)
+{
+    if (!AnyRasterizationRateMapsRegistered())
+    {
+        return nil;
+    }
+    RateMapRegistry &registry = Registry();
+    std::lock_guard<std::mutex> guard(registry.lock);
+    for (id<MTLTexture> t = texture; t != nil; t = [t parentTexture])
+    {
+        auto it = registry.entries.find((void *)t);
+        if (it != registry.entries.end())
+        {
+            return it->second.second.get();
+        }
+    }
+    auto bs = registry.bySize.find(SizeKey(width, height));
+    if (bs == registry.bySize.end() || samples < bs->second.first)
+    {
+        return nil;
+    }
+    return bs->second.second.get();
+}
+
+void SetRasterizationRateMapFor(id<MTLTexture> texture, id<MTLRasterizationRateMap> map)
+{
+    if (!texture)
+    {
+        return;
+    }
+    RateMapRegistry &registry = Registry();
+    std::lock_guard<std::mutex> guard(registry.lock);
+    if (map)
+    {
+        registry.entries[(void *)texture] = {texture, map};
+    }
+    else
+    {
+        registry.entries.erase((void *)texture);
+    }
+    registry.recount();
+    if (RasterizationRateTraceEnabled())
+    {
+        fprintf(stderr, "[angle-vrr] register tex=%p map=%p (%zu bound)\n", (void *)texture,
+                (void *)map, registry.entries.size());
+    }
+}
+
+void SetRasterizationRateMapForSize(uint32_t width,
+                                    uint32_t height,
+                                    uint32_t minSamples,
+                                    id<MTLRasterizationRateMap> map)
+{
+    if (width == 0 || height == 0)
+    {
+        return;
+    }
+    RateMapRegistry &registry = Registry();
+    std::lock_guard<std::mutex> guard(registry.lock);
+    if (map)
+    {
+        registry.bySize[SizeKey(width, height)] = {minSamples < 1 ? 1 : minSamples, map};
+    }
+    else
+    {
+        registry.bySize.erase(SizeKey(width, height));
+    }
+    registry.recount();
+    if (RasterizationRateTraceEnabled())
+    {
+        fprintf(stderr, "[angle-vrr] register size=%ux%u minSamples=%u map=%p (%zu size rules)\n",
+                width, height, minSamples, (void *)map, registry.bySize.size());
+    }
+}
+
+id<MTLRasterizationRateMap> GetRasterizationRateMapForSize(uint32_t width,
+                                                           uint32_t height,
+                                                           uint32_t samples)
+{
+    if (!AnyRasterizationRateMapsRegistered())
+    {
+        return nil;
+    }
+    RateMapRegistry &registry = Registry();
+    std::lock_guard<std::mutex> guard(registry.lock);
+    auto it = registry.bySize.find(SizeKey(width, height));
+    if (it == registry.bySize.end() || samples < it->second.first)
+    {
+        return nil;
+    }
+    return it->second.second.get();
+}
+
 }  // namespace mtl
 }  // namespace rx
+
+// The entry points Klepton resolves by dlsym. Deliberately outside every ANGLE
+// namespace and taking void* rather than id<> so the caller needs no ANGLE and
+// no Objective-C headers — kl_glfb.c is plain C.
+//
+// Passing a null map unbinds, which the caller MUST do before releasing the
+// texture (see the retain note above).
+extern "C" __attribute__((visibility("default"))) void ANGLEMetalSetRasterizationRateMap(
+    void *mtlTexture,
+    void *mtlRateMap)
+{
+    rx::mtl::SetRasterizationRateMapFor((id<MTLTexture>)mtlTexture,
+                                        (id<MTLRasterizationRateMap>)mtlRateMap);
+}
+
+// Every colour render target of exactly this size gets this map. See the header
+// for why the size, and not the object, is the workable key for the guest's
+// multisampled scene target.
+extern "C" __attribute__((visibility("default"))) void ANGLEMetalSetRasterizationRateMapForSize(
+    uint32_t width,
+    uint32_t height,
+    uint32_t minSamples,
+    void *mtlRateMap)
+{
+    rx::mtl::SetRasterizationRateMapForSize(width, height, minSamples,
+                                            (id<MTLRasterizationRateMap>)mtlRateMap);
+}
