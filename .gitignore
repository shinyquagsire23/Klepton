# app assets
/beatsaber/*
/beatsaber-*/
/steamlink-android/*
/steamlink-vr/*
/superhot/*
/bonelab/*
# ...and its game data, which does not ship in the APK: BONELAB is a split
# application binary and the two .obb files beside it are 6.8 GB.
/bonelab_obb/*
/vrchat/*
/openbrush/*
/re4/*
# ...and its game data, for bonelab's reason: RE4 ships a main AND a patch OBB,
# 8.5 GB between them.
/re4_obb/*
*.apk

# claude — CLAUDE.md and its notes/ satellites are local working notes
/.claude/*
CLAUDE.md
/notes/
/planning/
PLANNING.md
STYLE.md
# ...and any COPY of them. The rules above are path-anchored, so a backup
# directory holding CLAUDE.md/notes/ is not covered by them and `git add -A`
# will happily stage it — which is how PLANNING.md reached history the first
# time (purged 2026-08-09).
.doc-backup*/
*.bak

# pi coding agent — local session/mesh state
.pi/

# binaries
*.dSYM/
*.dylib
*.o
/build/*

# spike build output — all regenerated by mkframeworks.sh / xcodebuild
/spikes/device-probe/build/
/spikes/device-probe/Frameworks/
/spikes/s01_tpidr
/spikes/s01b_tpidr
/spikes/s01c_fix
/spikes/s02_variadic
/spikes/s05_x18
/spikes/s06_redzone

# macOS junk
.DS_Store

# vendored ANGLE toolchain + build (too large to commit)
vendor/
# ...and the MoltenVK prebuilt, for the same reason. Separate from vendor/ on
# purpose: vendor/ IS the ANGLE checkout (ANGLE sits at its root), so anything
# else living in there would be an untracked stowaway inside another project's
# git. Recreated by `make mvk`; the tracked artifacts are tools/mvk_fetch.sh,
# tools/mvk_retarget.sh, and the version+sha256 pin inside the former.
vendor-moltenvk/
fbo_dump/
tex_dump/
metal_workload.trace/

# visionOS app build artefacts (generated by visionos/run.sh)
visionos/build/
visionos/Frameworks/
# ...one per target now (visionos/targets.py): Klepton, KleptonSteamLink, ...
visionos/*.xcodeproj/

# Python bytecode from visionos/targets.py, imported by gen_xcodeproj.py
visionos/__pycache__/
tools/__pycache__/
