# app assets
/beatsaber/*
/beatsaber-*/
/steamlink-android/*
/steamlink-vr/*
/superhot/*
/bonelab/*
# ...and its game data, which does not ship in the APK: BONELAB is a split
# application binary and the two .obb files beside it are 6.8 GB.
/bonelab_obb/*
*.apk

# claude — CLAUDE.md and its notes/ satellites are local working notes
/.claude/*
CLAUDE.md
/notes/
/planning/
PLANNING.md

# pi coding agent — local session/mesh state
.pi/

# binaries
*.dSYM/
*.dylib
*.o
/build/*

# spike build output — all regenerated by mkframeworks.sh / xcodebuild
/spikes/device-probe/build/
/spikes/device-probe/Frameworks/
/spikes/s01_tpidr
/spikes/s01b_tpidr
/spikes/s01c_fix
/spikes/s02_variadic
/spikes/s05_x18
/spikes/s06_redzone

# macOS junk
.DS_Store

# vendored ANGLE toolchain + build (too large to commit)
vendor/
fbo_dump/
tex_dump/
metal_workload.trace/

# visionOS app build artefacts (generated by visionos/run.sh)
visionos/build/
visionos/Frameworks/
# ...one per target now (visionos/targets.py): Klepton, KleptonSteamLink, ...
visionos/*.xcodeproj/

# Python bytecode from visionos/targets.py, imported by gen_xcodeproj.py
visionos/__pycache__/
tools/__pycache__/
