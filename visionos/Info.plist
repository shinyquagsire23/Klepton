	<string>$(KL_VK_FOVEATION_DEFAULT)</string>
	<key>KLPictureReset</key>
	<string>$(KL_PICTURE_RESET)</string>
	<key>KLMaxRateDefault</key>
	<string>$(KL_MAX_RATE_DEFAULT)</string>
	<key>KLFrameGenDefault</key>
	<string>$(KL_FRAMEGEN_DEFAULT)</string>
	<key>KLTestOn</key>
	<string>$(KL_TEST_ON)</string>
	<key>KLTestBuild</key>
	<string>$(KL_TEST_BUILD)</string>
	<key>KLRoomGuardDefault</key>
	<string>$(KL_ROOM_GUARD_DEFAULT)</string>
	<key>KLGameLanguageDefault</key>
	<string>$(KL_GAME_LANGUAGE_DEFAULT)</string>
	<key>KLOutputDefault</key>
	<string>$(KL_OUTPUT_DEFAULT)</string>
	<key>KLStartScreen</key>
	<string>$(KL_START_SCREEN)</string>
	<key>KLOvrpGuestVersion</key>
	<string>$(KL_OVRP_GUEST_VERSION)</string>
	<key>KLMetaApkID</key>
	<string>$(KL_DATA_APK_ID)</string>
	<key>KLMetaObbID</key>
	<string>$(KL_DATA_OBB_ID)</string>
	<key>KLObbFile</key>
	<string>$(KL_DATA_OBB_FILE)</string>
	<key>KLObbRel</key>
	<string>$(KL_DATA_OBB_REL)</string>
	<key>KLTree</key>
	<string>$(KL_DATA_TREE)</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationPreferredDefaultSceneSessionRole</key>
		<string>UIWindowSceneSessionRoleApplication</string>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UISceneSessionRoleImmersiveSpaceApplication</key>
			<array>
				<dict>
					<key>UISceneInitialImmersionStyle</key>
					<string>UIImmersionStyleMixed</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIFileSharingEnabled</key>
	<true/>
	<!-- Privacy strings. Also emitted as INFOPLIST_KEY_* by gen_xcodeproj.py,
	     because Xcode moves them out of this file when the project is edited
	     in its Info tab. Missing from the built app = TCC kill at launch. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>Klepton uses the microphone only when you turn on the Microphone toggle, so a running app (such as Steam Link voice chat) can hear you.</string>
	<key>NSWorldSensingUsageDescription</key>
	<string>Klepton reads the headset's own pose, which is the head pose the guest renders from, the floor and walls of your room for a mixed-reality game, and, when you measure your room, its floor, walls and furniture to find the play area.</string>
	<key>KLSharedKeychainGroup</key>
	<string>$(AppIdentifierPrefix)avpplay.shared</string>
	<key>NSHandsTrackingUsageDescription</key>
	<string>Klepton maps your hands onto the guest's two Touch controllers.</string>
	<key>NSAccessoryTrackingUsageDescription</key>
	<string>Klepton maps PSVR2 Sense controllers onto the guest's two Touch controllers.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Klepton connects to spatial controllers that are not visible to the system as standard game controllers.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Steam Link finds the PCs on your network by broadcasting to them, and streams from the one you pair with.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_klepton-lan._udp</string>
	</array>
</dict>
</plist>
