    <key>KLScotland2Diagnostics</key>
    <string>$(KL_SCOTLAND2_DIAGNOSTICS)</string>
    <key>KLScotland2Profile</key>
    <string>$(KL_SCOTLAND2_PROFILE)</string>
    <key>KLAllowTestSwitches</key>
    <string>$(KL_ALLOW_TEST_SWITCHES)</string>
    <key>KLScotland2Test</key>
    <string>$(KL_SCOTLAND2_TEST)</string>
    <key>KLScotland2MetaCore</key>
    <string>$(KL_SCOTLAND2_METACORE)</string>
    <key>KLScotland2CoreMods</key>
    <string>$(KL_SCOTLAND2_COREMODS)</string>
    <key>KLScotland2SongDownloader</key>
    <string>$(KL_SCOTLAND2_SONGDOWNLOADER)</string>
    <key>KLScotland2SongCore</key>
    <string>$(KL_SCOTLAND2_SONGCORE)</string>
    <key>KLScotland2BSML</key>
    <string>$(KL_SCOTLAND2_BSML)</string>
    <key>KLScotland2Lapiz</key>
    <string>$(KL_SCOTLAND2_LAPIZ)</string>
    <key>KLScotland2CustomTypes</key>
    <string>$(KL_SCOTLAND2_CUSTOMTYPES)</string>
    <key>KLScotland2Hooks</key>
    <string>$(KL_SCOTLAND2_HOOKS)</string>
	<key>CFBundleIconName</key>
	<string>$(KL_APPICON_NAME)</string>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>SpatialGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
	</array>
	<key>KLApkName</key>
	<string>$(KL_DATA_APK)</string>
	<key>KLControllerModeDefault</key>
	<string>$(KL_CONTROLLER_MODE_DEFAULT)</string>
	<key>KLSurrealAvailable</key>
	<string>$(KL_SURREAL_AVAILABLE)</string>
	<key>KLGamepadMap</key>
	<string>$(KL_GAMEPAD_MAP)</string>
	<key>KLHandMattingDefault</key>
	<string>$(KL_HAND_MATTING_DEFAULT)</string>
	<key>KLRenderScaleDefault</key>
	<string>$(KL_RENDER_SCALE_DEFAULT)</string>
	<key>KLVideoDefault</key>
	<string>$(KL_VIDEO_DEFAULT)</string>
	<key>KLAutoBootDefault</key>
	<string>$(KL_AUTOBOOT_DEFAULT)</string>
	<key>KLFoveationDefault</key>
	<string>$(KL_FOVEATION_DEFAULT)</string>
	<key>KLFoveationReset</key>
	<string>$(KL_FOVEATION_RESET)</string>
	<key>KLVkMsaaDefault</key>
	<string>$(KL_VK_MSAA_DEFAULT)</string>
