+// The host app's favourites and most played, first and only where they hold songs.
+std::vector<Playlist> Client::withAppleMusicLists(std::vector<Playlist> playlists) {
+    if (!AirbudsSearch::hasAppleMusicHistory()) {
+        return playlists;
+    }
+    std::vector<Playlist> lists;
+    for (const auto& list : APPLE_MUSIC_LISTS) {
+        const std::vector<PlaylistTrack> tracks = loadRecentlyPlayedCache(AirbudsSearch::getDataDirectory() / list.file).tracks;
+        if (tracks.empty()) {
+            continue;
+        }
+        Playlist playlist;
+        playlist.id = list.id;
+        playlist.name = list.name;
+        playlist.totalItemCount = tracks.size();
+        playlist.imageUrl = tracks.front().album.url;
+        lists.push_back(playlist);
+    }
+    lists.insert(lists.end(), playlists.begin(), playlists.end());
+    return lists;
+}
