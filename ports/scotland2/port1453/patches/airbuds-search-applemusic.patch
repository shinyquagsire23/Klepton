+// The host app writes why its Apple Music list is empty or stale (no permission, no MusicKit service).
+std::string readAppleMusicMessage(const std::filesystem::path& path) {
+    std::ifstream file(path, std::ios::binary);
+    if (!file.is_open()) {
+        return "";
+    }
+    std::string data((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+    rapidjson::Document document;
+    document.Parse(data.c_str());
+    if (!document.IsObject() || !document.HasMember("status") || !document["status"].IsString()
+        || std::string(document["status"].GetString()) == "ok") {
+        return "";
+    }
+    if (document.HasMember("message") && document["message"].IsString()) {
+        return document["message"].GetString();
+    }
+    return "Apple Music history is not available.";
+}
+
