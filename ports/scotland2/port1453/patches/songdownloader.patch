-bool DownloadSongsSearchViewController::UpdatePagination(const BeatSaver::Page& page) {
-    const auto info = page.GetInfo();
-    return UpdatePagination(page.GetDocs().size(), info ? std::optional<int>(info->GetPages()) : std::nullopt);
-}
