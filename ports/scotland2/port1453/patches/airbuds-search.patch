+#pragma once
+// Preserve the original JSON schema while using the SDK 9 filesystem API.
+#include "beatsaber-hook/shared/rapidjson.hpp"
+#include "safe-save.hpp"
+#include "beatsaber-hook/shared/rapidjson/include/rapidjson/stringbuffer.h"
+#include <filesystem>
+#include <fstream>
+#include <string>
+
+namespace AirbudsSearch {
+class Configuration {
+    std::string path;
+    bool writable = true;
+public:
+    rapidjson::Document config;
+    explicit Configuration(std::string filePath) : path(std::move(filePath)) { config.SetObject(); }
+    void Load() {
+        std::error_code error;
+        const auto status = std::filesystem::symlink_status(path, error);
+        if (error && error != std::errc::no_such_file_or_directory) { writable = false; return; }
+        if (status.type() == std::filesystem::file_type::not_found) return;
+        if (error || !std::filesystem::is_regular_file(status)) { writable = false; return; }
+        auto size = std::filesystem::file_size(path, error);
+        if (error || size > 2*1024*1024) { writable = false; return; }
+        std::ifstream input(path, std::ios::binary);
+        std::string contents(static_cast<size_t>(size), '\0');
+        input.read(contents.data(),contents.size());
+        if (!input) { writable = false; return; }
+        rapidjson::Document parsed;
+        parsed.Parse(contents.data(), contents.size());
+        if (parsed.HasParseError() || !parsed.IsObject()) { writable = false; return; }
+        config.Swap(parsed);
+    }
+    void Write() {
+        if (!writable || !config.IsObject()) return;
+        // Write a private unique file, then use the already tested atomic save
+        // boundary. Failure preserves the previous settings and refresh token.
+        std::lock_guard<std::recursive_mutex> lock(sc2_save::mutex);
+        rapidjson::StringBuffer buffer;
+        rapidjson::Writer<rapidjson::StringBuffer> writer(buffer);
+        if (!config.Accept(writer) || buffer.GetSize() > 2*1024*1024) return;
+        static std::atomic<unsigned long long> sequence{0};
+        std::filesystem::path temporary;
+        int fd = -1;
+        try {
+            std::filesystem::create_directories(std::filesystem::path(path).parent_path());
+            for (unsigned attempt = 0; attempt < 128; ++attempt) {
+                auto candidate = path + ".sc2-" + std::to_string(getpid()) + "-" + std::to_string(sequence.fetch_add(1));
+                fd = open(candidate.c_str(), O_WRONLY|O_CREAT|O_EXCL|O_NOFOLLOW, 0600);
+                if (fd >= 0) { temporary = candidate; break; }
+                if (errno != EEXIST) return;
+            }
+            if (fd < 0) return;
+            size_t copied = 0;
+            while (copied < buffer.GetSize()) {
+                auto count = write(fd, buffer.GetString()+copied, buffer.GetSize()-copied);
+                if (count < 0 && errno == EINTR) continue;
+                if (count <= 0) throw std::runtime_error("settings write failed");
+                copied += count;
+            }
+            if (fsync(fd)) throw std::runtime_error("settings sync failed");
+            auto result = close(fd); fd = -1;
+            if (result) throw std::runtime_error("settings close failed");
+            sc2_save::atomic_copy(temporary,path);
+        } catch (...) { if (fd >= 0) close(fd); }
+        if (!temporary.empty()) { std::error_code ignored; std::filesystem::remove(temporary,ignored); }
+    }
+};
+}
